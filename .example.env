# Copy to .env for local development. Never commit the real file.
#
# In the container these come from docker-compose.yml's env_file (see
# docker-compose.yml, which points at ./env) and this file is not used at all.

# TDX API credentials: https://tdx.transportdata.tw/
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Telegram bot, from @BotFather. TG_BOT_TOKEN / TG_CHAT_ID are also accepted.
# Message the bot once, then read the chat ID from getUpdates; a private chat
# ID is positive, a leading "-" means a group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
