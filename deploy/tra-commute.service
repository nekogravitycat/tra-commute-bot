[Unit]
Description=TRA commute brief
Documentation=https://github.com/nekogravitycat/tra-commute-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tracommute
Group=tracommute

# Credentials live here, mode 0600, owned by tracommute. Never in git, never
# in config.yaml. The empty -env-file makes sure no stray file in the working
# directory can override what systemd supplies.
EnvironmentFile=/etc/tra-commute/env
ExecStart=/usr/local/bin/tracommute -config /etc/tra-commute/config.yaml -env-file ""

# Creates and owns /var/lib/tra-commute for the state file and the archives.
StateDirectory=tra-commute
StateDirectoryMode=0750

# A once-a-minute oneshot would otherwise flood journald with Started/Finished
# pairs. Ticks that miss the schedule exit quietly at DEBUG level, and this
# caps what the unit itself emits.
LogLevelMax=notice
SyslogIdentifier=tra-commute

# The run budget is ten seconds; 90 leaves room for the 429 backoff schedule
# (5+10+15) plus delivery retries.
TimeoutStartSec=90

# ── Hardening ─────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
