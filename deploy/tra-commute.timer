[Unit]
Description=TRA commute brief tick
Documentation=https://github.com/nekogravitycat/tra-commute-bot

[Timer]
# Wake once a minute. All scheduling semantics -- weekdays, times, make-up
# workdays, leave -- live in config.yaml and are decided by the program, so
# changing the schedule needs neither sudo nor a daemon-reload.
OnCalendar=*:0/1
AccuracySec=1s
RandomizedDelaySec=0
# Do not catch up after downtime: a commute brief delivered the next day is
# worse than none at all.
Persistent=false
Unit=tra-commute.service

[Install]
WantedBy=timers.target
